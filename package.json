    "build:index": "npm run build:browse-index && npm run build:similar-index",
    "build:browse-index": "tsx scripts/build-browse-index.ts",
    "build:similar-index": "tsx scripts/build-similar-index.ts",
    "import:source": "node scripts/import-source.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
