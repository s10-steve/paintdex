{
  "name": "paintdex",
  "version": "0.14.0",
  "private": true,
  "description": "A searchable database of miniature paints with perceptual colour matching and a paint scheme visualiser.",
  "license": "MIT",
  "homepage": "https://paintdex.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/s10-steve/paintdex.git"
  },
  "scripts": {
    "predev": "npm run build:index",
    "dev": "next dev",
    "prebuild": "npm run build:index",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:data": "tsx scripts/validate-data.ts",
    "build:index": "npm run build:browse-index && npm run build:similar-index",
    "build:browse-index": "tsx scripts/build-browse-index.ts",
    "build:similar-index": "tsx scripts/build-similar-index.ts",
    "import:source": "node scripts/import-source.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.110.8",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "js-yaml": "^4.3.1"
  }
}
