# Accounts are optional — with these unset the site runs fully (no sign-in,
# schemes save to localStorage only). See supabase/schema.sql for the tables
# these vars connect to, and supabase/README.md for how the projects are set up.
#
# Point the Supabase pair at the STAGING project, never production. There is one
# Supabase project per environment: production's keys live in Vercel's Production
# scope and nowhere else, so nothing you do locally can reach a real user's
# scheme. The Google client id is the same one either way — it only identifies
# who the token was minted for, and each Supabase project has its own users.
#
# This file is the local mechanism; Vercel's own "Development" env scope is not
# used, since `npm run dev` reads .env.local directly. Restart the dev server
# after editing — NEXT_PUBLIC_* is inlined at build time.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
