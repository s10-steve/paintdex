# Accounts are optional — with these unset the site runs fully (no sign-in,
# schemes save to localStorage only). See supabase/schema.sql for the tables
# these vars connect to, and supabase/README.md for how the projects are set up.
#
# Point these at the STAGING project, never production. There is one Supabase
# project per environment: production's keys live in Vercel's Production scope
# and nowhere else, so nothing you do locally can reach a real user's scheme.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
