# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# generated at build time from data/paints/*.json (npm run build:index)
/public/browse-index.json
/.cache/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# private local notes, not for the public repo
/SETUP-PRIVATE.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
